# Edge Function 비밀값 예시. 실제 값은 이 파일에 쓰지 말고 `supabase secrets set --env-file <저장소 밖 파일>`로 넣는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# interactions(기본) | generate_content
GEMINI_API_STYLE=interactions
GEMINI_THINKING_LEVEL=minimal
TTS_URL=https://<space-owner>-butterful-tts.hf.space
TTS_ZH_URL=
TTS_SHARED_SECRET=
# 로컬 개발 때만 1
ALLOW_LOCALHOST=0
# 사용자별 제한(비우면 기본값)
TURN_PER_MINUTE=8
TURN_PER_HOUR=80
TURN_PER_DAY=200
GLOBAL_TURNS_PER_MINUTE=0
TTS_PER_MINUTE=12
TTS_PER_DAY=300
